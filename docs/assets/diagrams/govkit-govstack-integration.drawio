        <mxCell id="s1-har-21" value="&lt;span style=&quot;font-family:IBM Plex Mono;font-size:14px;font-weight:600;color:#111111;&quot;&gt;related_govkit&lt;/span&gt;&lt;br&gt;&lt;div style='margin-top:3px'&gt;&lt;span style=&quot;font-family:IBM Plex Sans;font-size:13px;font-weight:400;color:#5C5C5C;&quot;&gt;assess · start · applicability hand off to compliance&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=24;spacingRight=12;fillColor=#FFFFFF;strokeColor=#D9D9D9;strokeWidth=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="976" y="424" width="464" height="64" as="geometry"/></mxCell>
