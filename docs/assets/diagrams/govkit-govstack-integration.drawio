<mxfile host="govkit" agent="GovKit" version="24.0.0">
  <diagram id="s1-integration" name="Integration view">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1-sheet-1" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell>
        <mxCell id="s1-v-2" value='&lt;span style="font-family:IBM Plex Sans Condensed;font-size:12px;font-weight:600;color:#5C5C5C;letter-spacing:1.5px;"&gt;ADVISORY · GOVKIT × GOVSTACK&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="64" y="56" width="800" height="24" as="geometry"/></mxCell>
        <mxCell id="s1-v-3" value='&lt;span style="font-family:IBM Plex Sans;font-size:44px;font-weight:300;color:#111111;letter-spacing:-0.5px;"&gt;GovStack extends GovKit the way GovKit extends ArcKit&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="64" y="80" width="1376" height="64" as="geometry"/></mxCell>
        <mxCell id="s1-v-4" value='&lt;span style="font-family:IBM Plex Sans;font-size:16px;font-weight:400;color:#5C5C5C;line-height:26px;"&gt;GovStack 2.1 supplies the requirements. GovKit&amp;#x27;s GovStack module, govkit-govstack, turns them into four governed commands. GovKit takes them through its own extension points, and ArcKit core stays untouched.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="64" y="152" width="1216" height="56" as="geometry"/></mxCell>
        <mxCell id="s1-v-5" value='&lt;span style="font-family:IBM Plex Sans Condensed;font-size:12px;font-weight:600;color:#5C5C5C;letter-spacing:1.5px;"&gt;SOURCE · GOVSTACK 2.1 SPECIFICATIONS&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="64" y="232" width="400" height="24" as="geometry"/></mxCell>
        <mxCell id="s1-v-6" value='&lt;span style="font-family:IBM Plex Sans Condensed;font-size:12px;font-weight:600;color:#CC3A1C;letter-spacing:1.5px;"&gt;MODULE · GOVKIT GOVSTACK (GOVKIT-GOVSTACK)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="528" y="232" width="384" height="24" as="geometry"/></mxCell>
        <mxCell id="s1-v-7" value='&lt;span style="font-family:IBM Plex Sans Condensed;font-size:12px;font-weight:600;color:#5C5C5C;letter-spacing:1.5px;"&gt;HARNESS · GOVKIT 0.4, EXTENDED NOT FORKED&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="976" y="232" width="464" height="24" as="geometry"/></mxCell>
        <mxCell id="s1-src-8" value="&lt;span style=&quot;font-family:IBM Plex Sans Condensed;font-size:12px;font-weight:600;color:#5C5C5C;letter-spacing:1.5px;&quot;&gt;CORE&lt;/span&gt;&lt;br&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;font-family:IBM Plex Sans;font-size:17px;font-weight:500;color:#111111;&quot;&gt;9 principles + 78 cross-functional requirements&lt;/span&gt;&lt;/div&gt;&lt;div style='margin-top:6px;line-height:20px'&gt;&lt;span style=&quot;font-family:IBM Plex Sans;font-size:13px;font-weight:400;color:#5C5C5C;&quot;&gt;19 REQUIRED · every block inherits &lt;/span&gt;&lt;span style=&quot;font-family:IBM Plex Mono;font-size:12px;font-weight:600;color:#111111;&quot;&gt;govstack-cfr-2.1.0&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=16;spacingTop=16;fillColor=#FFFFFF;strokeColor=#D9D9D9;strokeWidth=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="64" y="264" width="400" height="136" as="geometry"/></mxCell>
        <mxCell id="s1-src-9" value="&lt;span style=&quot;font-family:IBM Plex Sans Condensed;font-size:12px;font-weight:600;color:#5C5C5C;letter-spacing:1.5px;&quot;&gt;BUILDING BLOCKS&lt;/span&gt;&lt;br&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;font-family:IBM Plex Sans;font-size:17px;font-weight:500;color:#111111;&quot;&gt;14 reusable blocks&lt;/span&gt;&lt;/div&gt;&lt;div style='margin-top:6px;line-height:20px'&gt;&lt;span style=&quot;font-family:IBM Plex Sans;font-size:13px;font-weight:400;color:#5C5C5C;&quot;&gt;Identity, Information Mediator, Workflow (foundational), Payments, Registration, Messaging and 8 more&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=16;spacingTop=16;fillColor=#FFFFFF;strokeColor=#D9D9D9;strokeWidth=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;" vertex="1" parent="1"><mxGeometry x="64" y="416" width="400" height="136" as="geometry"/></mxCell>
