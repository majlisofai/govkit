# Example settings. Placeholders only: real values are injected at runtime
# from the secret store. Never put real values in this file.
LICENSING_DB_URL=postgresql://<user>:<password>@<host>:5432/licensing
LICENSING_OIDC_ISSUER=https://<identity-host>/realms/<realm>
LICENSING_OIDC_AUDIENCE=licensing-service
LICENSING_IM_BASE_URL=https://<information-mediator-host>
LICENSING_LOG_LEVEL=info
