{
  "$comment": "GovKit overlay manifest. /govkit-govstack:apply installs doc_types into .govkit/doc-types.json and copies the installs files into a GovKit content layer. scripts/check-compat.mjs and scripts/validate-content.py read this file.",
  "overlay": "govkit-govstack",
  "govkit": {
    "min": "0.4.0",
    "max_exclusive": "1.0.0"
  },
  "doc_types": {
    "GSBB": {
      "name": "GovStack Building Block Map",
      "category": "Architecture",
      "command": "govkit-govstack:map",
      "template": "bb-map"
    },
    "GSCA": {
      "name": "GovStack Compliance Assessment",
      "category": "Assurance",
      "command": "govkit-govstack:compliance",
      "template": "compliance",
      "multiInstance": true,
      "subdir": "govstack"
    }
  },
  "installs": [
    "frameworks/govstack-cfr.yaml"
  ]
}
