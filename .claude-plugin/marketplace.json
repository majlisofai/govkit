{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "majlisofai",
  "owner": {
    "name": "The Majlis of AI"
  },
  "metadata": {
    "description": "GovKit — a customizable governance overlay for ArcKit, and GovKit overlays",
    "version": "0.4.0"
  },
  "allowCrossMarketplaceDependenciesOn": [
    "arckit-claude"
  ],
  "plugins": [
    {
      "name": "govkit",
      "source": "./plugins/govkit",
      "description": "Governance overlay for ArcKit — profile-driven approach, methods, frameworks and tools. Requires the arckit core plugin.",
      "version": "0.4.0",
      "author": {
        "name": "The Majlis of AI"
      },
      "license": "MIT",
      "keywords": [
        "governance",
        "architecture",
        "ai-governance",
        "compliance",
        "arckit"
      ],
      "category": "productivity",
      "dependencies": [
        {
          "name": "arckit",
          "marketplace": "arckit-claude"
        }
      ],
      "homepage": "https://github.com/majlisofai/govkit",
      "repository": "https://github.com/majlisofai/govkit"
    },
    {
      "name": "govkit-govstack",
      "source": "./plugins/govkit-govstack",
      "description": "GovStack overlay for GovKit — map programmes to GovStack building blocks and self-assess solutions against GovStack requirements. Requires the govkit plugin.",
      "version": "0.1.0",
      "author": {
        "name": "The Majlis of AI"
      },
      "license": "MIT",
      "keywords": [
        "govstack",
        "digital-public-infrastructure",
        "building-blocks",
        "interoperability",
        "govkit"
      ],
      "category": "productivity",
      "dependencies": [
        {
          "name": "govkit",
          "marketplace": "majlisofai"
        }
      ],
      "homepage": "https://majlisofai.github.io/govkit/",
      "repository": "https://github.com/majlisofai/govkit"
    }
  ]
}
